#!/usr/bin/env python3
"""Claude Code sessions running in Ghostty, grouped by what they are working on.
Click a session to jump to its tab.

Read-only: it reads Ghostty's tabs (through JXA, by pid), Claude Code's
~/.claude*/sessions/<pid>.json and the saved conversations. The only thing it
changes is which tab has focus, when you click.

Usage: ghostty-sessions                print the list once
       ghostty-sessions --sidebar      open the list in a narrow Ghostty window on the left
       ghostty-sessions --watch N      interactive list, refreshed every N seconds (q quits)
       ghostty-sessions --plan NAME    from inside a session: pin it to a plan; any part of
                                      the name that matches only one plan works (`-` unpins)
       ghostty-sessions --check        says whether everything it needs is in place
       ghostty-sessions --auto-open    for a SessionStart hook: opens the sidebar if the config
                                      says "auto_open": true, this is Ghostty, and none is open

Grouping. With plans configured, each session goes under the plan it is working on,
judged by what it does with its tools: among its last `window` mentions of a plan
file, the one with the most weight, where editing the plan weighs `edit_weight` and
reading or naming it weighs 1. What that gets wrong (a session that edited someone
else's plan in passing) is fixed with --plan. Without plans, sessions are grouped by
the git repository they started in.

Config, all optional: ~/.config/ghostty-sessions/config.json (see README).
Errors from --watch go to ~/Library/Logs/ghostty-sessions.log
"""
import glob, hashlib, json, os, re, select, shlex, signal, subprocess, sys, termios, threading, time, tty

HOME = os.path.expanduser("~")
CONFIG_PATH = os.environ.get("GHOSTTY_SESSIONS_CONFIG", HOME + "/.config/ghostty-sessions/config.json")
ASSIGNED = HOME + "/Library/Caches/ghostty-sessions-plans.json"
LOG = HOME + "/Library/Logs/ghostty-sessions.log"

DEFAULTS = {
    "claude_dirs": None,      # None: every ~/.claude* directory that has a sessions/ folder
    "plans": [],              # [{"dir": "~/notes", "pattern": "PLAN_*.md"}]
    "edit_weight": 10,        # editing a plan says more than reading it
    "window": 60,             # only recent mentions count: a long session that moves on, moves group
    "strip_prefixes": [],     # removed from worktree and repository names on screen, e.g. ["acme-"]
    "ghostty_app": "/Applications/Ghostty.app",
    "auto_open": False,       # --auto-open opens the sidebar only when this is true
    "sidebar": {"width": 44, "font_size": 11},
}


def load_config(path=CONFIG_PATH):
    cfg = json.loads(json.dumps(DEFAULTS))
    try:
        with open(path) as fh:
            user = json.load(fh)
    except FileNotFoundError:
        user = {}
    except ValueError as e:
        sys.exit(f"ghostty-sessions: {path} is not valid JSON: {e}")
    for k, v in user.items():
        if k == "sidebar" and isinstance(v, dict):
            cfg["sidebar"].update(v)
        else:
            cfg[k] = v
    if cfg["claude_dirs"] is None:
        cfg["claude_dirs"] = sorted(os.path.dirname(p) for p in glob.glob(HOME + "/.claude*/sessions"))
    cfg["claude_dirs"] = [os.path.expanduser(d) for d in cfg["claude_dirs"]]
    cfg["plans"] = [plan_source(p) for p in cfg["plans"]]
    return cfg


def plan_source(p):
    """A plan folder and its file pattern, with the regex that finds its names in text."""
    pattern = p.get("pattern", "*.md")
    if pattern.count("*") != 1 or "/" in pattern:
        sys.exit(f"ghostty-sessions: plan pattern {pattern!r} needs exactly one * and no /")
    prefix, suffix = pattern.split("*")
    return {"dir": os.path.join(os.path.expanduser(p["dir"]), ""), "pattern": pattern,
            "prefix": prefix, "suffix": suffix,
            "re": re.compile(re.escape(prefix) + r"[A-Za-z0-9_.-]+?" + re.escape(suffix))}


CFG = None  # filled in main(); tests set it themselves

# JXA, not AppleScript: with two Ghostty instances open (the sessions' and this list's),
# `tell application` picks one at random; Application(pid) talks to the right one.
JXA_LIST = '''
function run(argv) {
  const app = Application(parseInt(argv[0]));
  const out = [];
  const front = app.frontWindow.id();
  app.windows().forEach(w => w.tabs().forEach(t => {
    const ft = t.focusedTerminal();
    const sel = (w.id() === front && t.selected()) ? "1" : "0";
    out.push([w.id(), t.index(), ft.tty(), sel, t.name()].join("\\t"));
  }));
  return out.join("\\n");
}
'''
JXA_FOCUS = '''
function run(argv) {
  const app = Application(parseInt(argv[0]));
  for (const w of app.windows()) for (const t of w.tabs()) {
    const ft = t.focusedTerminal();
    if (ft.tty() === argv[1]) { app.focus(ft); app.activate(); return "ok"; }
  }
  return "no";
}
'''

PR_RE = re.compile(r"github\.com/[\w.-]+/([\w.-]+)/pull/(\d+)")
PATH_RE = re.compile(r"(?<![\w.~-])(/(?:[\w.@+-]+/)*[\w.@+-]+)")
SPINNER = "◐◑◒◓⠂⠐✳"
WRITE_TOOLS = ("Edit", "Write", "MultiEdit", "NotebookEdit")

_facts = {}      # transcript -> {"off": bytes read, "events", "wt", "pr"}
_worktree = {}   # directory -> linked worktree root, or None
_repo = {}       # cwd -> repository name, or None


def run(cmd, timeout=10):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


# ── what is running ─────────────────────────────────────────────────────────

def claude_by_tty():
    res = {}
    for line in run(["ps", "-A", "-o", "pid=,tty=,comm="]).splitlines():
        f = line.split(None, 2)
        if len(f) == 3 and f[2].strip().endswith("claude") and f[1].startswith("ttys"):
            res[f[1]] = int(f[0])
    return res


def ghostty_pid(pids):
    """The Ghostty the sessions hang from: walk up the parents of one of them."""
    for p in pids:
        for _ in range(10):
            out = run(["ps", "-o", "ppid=,comm=", "-p", str(p)]).strip()
            if not out:
                break
            ppid, comm = out.split(None, 1)
            if comm.endswith("MacOS/ghostty"):
                return p
            p = int(ppid)
    return None


def ghostty_tabs(gpid):
    if not gpid:
        return []
    tabs = []
    for line in run(["osascript", "-l", "JavaScript", "-e", JXA_LIST, str(gpid)]).splitlines():
        p = line.split("\t")
        if len(p) == 5:
            tabs.append({"win": p[0], "idx": int(p[1]), "tty": p[2].replace("/dev/", ""),
                         "selected": p[3] == "1", "title": p[4]})
    return tabs


def session_meta(pid):
    for c in CFG["claude_dirs"]:
        try:
            with open(f"{c}/sessions/{pid}.json") as fh:
                d = json.load(fh)
        except (OSError, ValueError):
            continue
        if d.get("sessionId"):
            d["_config"] = c
            return d
    return None


# ── what each session is doing ──────────────────────────────────────────────

def pick_plan(events):
    """The session's plan: the heaviest among its recent mentions (editing weighs
    edit_weight, reading or naming 1). On a tie, the one mentioned last."""
    score, last = {}, {}
    for i, (plan, weight) in enumerate(events[-CFG["window"]:]):
        score[plan] = score.get(plan, 0) + weight
        last[plan] = i
    return max(score, key=lambda p: (score[p], last[p])) if score else None


def linked_worktree(path):
    """The root of the linked git worktree `path` is in (where .git is a file), or None."""
    d = path if os.path.isdir(path) else os.path.dirname(path)
    seen = []
    while d and d not in ("/", HOME):
        if d in _worktree:
            hit = _worktree[d]
            break
        seen.append(d)
        dot = os.path.join(d, ".git")
        if os.path.isfile(dot):
            hit = d
            break
        if os.path.isdir(dot):
            hit = None
            break
        d = os.path.dirname(d)
    else:
        hit = None
    for s in seen:
        _worktree[s] = hit
    return hit


def repo_name(cwd):
    """The repository `cwd` belongs to, by its main checkout's folder (so a worktree
    groups with its repository)."""
    if cwd not in _repo:
        common = run(["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"], 5).strip()
        if not common:
            _repo[cwd] = None
        else:
            root = os.path.dirname(common) if os.path.basename(common) == ".git" else common
            _repo[cwd] = os.path.basename(root.rstrip("/")) or None
    return _repo[cwd]


def transcript_facts(meta):
    paths = glob.glob(f"{meta['_config']}/projects/*/{meta.get('sessionId')}.jsonl")
    if not paths:
        return {}
    path = paths[0]
    fresh = {"off": 0, "events": [], "wt": None, "pr": None}
    st = _facts.setdefault(path, dict(fresh, events=[]))
    try:
        size = os.path.getsize(path)
        if size < st["off"]:  # rewritten: start over
            st.update(fresh, events=[])
        if size > st["off"]:
            with open(path, "rb") as fh:
                fh.seek(st["off"])
                chunk = fh.read()
            end = chunk.rfind(b"\n") + 1  # a half-written line is read next time
            st["off"] += end
            # Only what the session did with its tools, not the text hooks inject into it.
            for line in chunk[:end].decode("utf-8", "replace").splitlines():
                if '"tool_use"' in line:
                    read_tool_uses(line, st)
            st["events"] = st["events"][-CFG["window"]:]
    except OSError:
        pass
    return {"plan": pick_plan(st["events"]), "wt": st["wt"], "pr": st["pr"]}


def read_tool_uses(line, st):
    try:
        content = json.loads(line).get("message", {}).get("content") or []
    except ValueError:
        return
    for c in content:
        if not isinstance(c, dict) or c.get("type") != "tool_use":
            continue
        inp = c.get("input") or {}
        raw = json.dumps(inp, ensure_ascii=False)
        if "ghostty-sessions --plan" in raw:  # pinning by hand is not working on the plan
            continue
        # Editing weighs only when the edited file is the plan; naming it inside another
        # file (a test, a script) is one more mention.
        writes = c.get("name") in WRITE_TOOLS
        edited = str(inp.get("file_path", "")) if writes else ""
        for src in CFG["plans"]:
            for m in src["re"].finditer(raw):
                name = m.group(0)
                if os.path.isfile(src["dir"] + name):  # a name that is not a plan does not group
                    st["events"].append((src["dir"] + name, CFG["edit_weight"]
                                         if edited == src["dir"] + name else 1))
        for m in PATH_RE.finditer(raw):
            wt = linked_worktree(m.group(1))
            if wt:
                st["wt"] = os.path.basename(wt)
        if writes:  # a PR link inside a file being written (a test, a doc) is not this session's PR
            continue
        for m in PR_RE.finditer(raw):
            st["pr"] = f"{m.group(1)}#{m.group(2)}"


def plan_label(path):
    name = os.path.basename(path)
    for src in CFG["plans"]:
        if path.startswith(src["dir"]):
            name = name[len(src["prefix"]):len(name) - len(src["suffix"]) or None]
            break
    return name.replace("_", " ").strip() or os.path.basename(path)


# ── plan pinned by hand ─────────────────────────────────────────────────────

def load_json(path, default):
    try:
        with open(path) as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.{os.getpid()}"
    with open(tmp, "w") as fh:
        json.dump(data, fh, ensure_ascii=False)
    os.replace(tmp, path)


def own_session():
    """The Claude session this process hangs from (walking up the parents)."""
    p = os.getpid()
    for _ in range(12):
        out = run(["ps", "-o", "ppid=,comm=", "-p", str(p)]).strip()
        if not out:
            return None
        ppid, comm = out.split(None, 1)
        if comm.strip().endswith("claude"):
            return session_meta(p)
        p = int(ppid)
    return None


def all_plans():
    return sorted(p for src in CFG["plans"] for p in glob.glob(src["dir"] + src["pattern"]))


def resolve_plan(text):
    """The exact plan file, or the only one whose name contains `text` (ignoring case,
    spaces, _ and -)."""
    plans = all_plans()
    if not CFG["plans"]:
        sys.exit("ghostty-sessions --plan: no plans configured (see README)")
    name = os.path.basename(text)
    exact = [p for p in plans if os.path.basename(p) == name]
    if len(exact) == 1:
        return exact[0]
    norm = lambda x: re.sub(r"[\s_-]+", "", x.lower())
    want = norm(name)
    hits = [p for p in plans if want and want in norm(os.path.basename(p))]
    if len(hits) == 1:
        return hits[0]
    if not hits:
        sys.exit(f"ghostty-sessions --plan: no plan matches {text!r}")
    sys.exit(f"ghostty-sessions --plan: {text!r} matches {len(hits)} plans: "
             + ", ".join(os.path.basename(p) for p in hits[:8]))


def assign_plan(text):
    meta = own_session()
    if not meta:
        sys.exit("ghostty-sessions --plan: not running inside a Claude Code session")
    pinned = load_json(ASSIGNED, {})
    if text in ("-", ""):
        pinned.pop(meta["sessionId"], None)
        print("unpinned: the plan is judged from the session's work again")
    else:
        path = resolve_plan(text)
        pinned[meta["sessionId"]] = path
        print(f"{meta.get('name') or meta['sessionId']} → {os.path.basename(path)}")
    save_json(ASSIGNED, pinned)


def short(name):
    for prefix in CFG["strip_prefixes"]:
        if name and name.startswith(prefix) and len(name) > len(prefix):
            return name[len(prefix):]
    return name


def collect():
    by_tty = claude_by_tty()
    gpid = ghostty_pid(by_tty.values())
    pinned = load_json(ASSIGNED, {})
    rows = []
    for t in ghostty_tabs(gpid):
        pid = by_tty.get(t["tty"])
        meta = session_meta(pid) if pid else None
        facts = transcript_facts(meta) if meta else {}
        cwd = (meta or {}).get("cwd", "")
        plan = pinned.get((meta or {}).get("sessionId")) or facts.get("plan")
        if plan:
            group = plan_label(plan)
        else:
            group = repo_name(cwd) if cwd else None
        wt = facts.get("wt") or (os.path.basename(linked_worktree(cwd) or "") if cwd else "") or None
        title = t["title"]
        if title[:1] in SPINNER:
            title = title[1:].strip()
        since = (meta or {}).get("statusUpdatedAt")
        rows.append({**t, "group": group, "name": title, "is_claude": bool(meta),
                     "wt": short(wt), "pr": short(facts.get("pr")),
                     "status": (meta or {}).get("status", ""),
                     "mins": (time.time() * 1000 - since) / 60000 if since else None})
    return gpid, rows


# ── drawing ─────────────────────────────────────────────────────────────────

ESC = "\033["
RST, BOLD, DIM = ESC + "0m", ESC + "1m", ESC + "2m"
PALETTE = [39, 208, 170, 114, 220, 75, 204, 150, 141, 180, 44, 167]


def fg(c):
    return f"{ESC}38;5;{c}m"


def bg(c):
    return f"{ESC}48;5;{c}m"


def group_color(name):
    return PALETTE[int(hashlib.md5(name.encode()).hexdigest(), 16) % len(PALETTE)]


def ago(m):
    if m is None:
        return ""
    if m < 1:
        return "now"
    if m < 60:
        return f"{int(m)}m"
    if m < 1440:
        return f"{int(m // 60)}h"
    return f"{int(m // 1440)}d"


def status_mark(r):
    s = r["status"]
    if not r["is_claude"]:
        return fg(244) + "·" + RST, ""
    if s == "busy":
        return fg(220) + "●" + RST, "working"
    if s == "shell":
        return fg(75) + "◆" + RST, "running a command"
    return fg(114) + "○" + RST, "waiting"


def fit(text, width):
    return text if len(text) <= width else text[: max(0, width - 1)] + "…"


def wrap(text, first_w, rest_w):
    """Split `text` by words: the first line is `first_w` wide, the rest `rest_w`."""
    lines, cur, limit = [], "", max(8, first_w)
    for word in text.split():
        while len(word) > limit:  # a word longer than the line is cut where it falls
            if cur:
                lines.append(cur)
                cur, limit = "", max(8, rest_w)
            lines.append(word[:limit])
            word, limit = word[limit:], max(8, rest_w)
        cand = f"{cur} {word}" if cur else word
        if len(cand) <= limit:
            cur = cand
        else:
            lines.append(cur)
            cur, limit = word, max(8, rest_w)
    lines.append(cur)
    return lines


def render(rows, width, hover=None):
    """Returns (lines, map line -> tty). `hover`: tty of the block under the mouse."""
    lines, hit = [], {}
    w = max(24, width)

    def add(s, tty_=None):
        if tty_:
            hit[len(lines)] = tty_
        lines.append(s)

    claude = [r for r in rows if r["is_claude"]]
    busy = sum(1 for r in claude if r["status"] in ("busy", "shell"))
    waiting = len(claude) - busy
    clock = time.strftime("%H:%M")
    head = " ◆ Sessions"
    add(bg(236) + BOLD + fg(255) + head + " " * (w - len(head) - len(clock) - 1) + DIM + clock + " " + RST)
    plain = f" {len(claude)} · ● {busy} working · ○ {waiting} waiting"
    stats = f" {len(claude)} · {fg(220)}● {busy} working{fg(250)} · {fg(114)}○ {waiting} waiting"
    add(bg(236) + fg(250) + stats + " " * max(0, w - len(plain)) + RST)
    add("")

    groups = {}
    for r in rows:
        groups.setdefault(r["group"], []).append(r)
    order = sorted(groups, key=lambda g: (g is None, (g or "").lower()))
    for g in order:
        rs = sorted(groups[g], key=lambda r: (r["win"], r["idx"]))
        if g is None:
            add(f"{fg(244)}▌ {BOLD}other{RST} {DIM}{len(rs)}{RST}")
        else:
            add(f"{fg(group_color(g))}▌ {BOLD}{fit(g, w - 6)}{RST} {DIM}{len(rs)}{RST}")
        for i, r in enumerate(rs):
            mark, label = status_mark(r)
            t = ago(r["mins"]) if r["is_claude"] else ""
            name_w = w - 7 - len(t) - 1
            idle_long = r["is_claude"] and r["status"] == "idle" and (r["mins"] or 0) >= 15
            tcol = fg(209) if idle_long else DIM
            # The whole title, split by words; the time on the right of the first line.
            parts = wrap(r["name"], name_w, w - 8)
            first = parts[0]
            block = [f"  {mark} {DIM}{r['idx']:>2}{RST} {BOLD}{first}{RST}"
                     + " " * max(0, name_w - len(first)) + f" {tcol}{t}{RST}"]
            for p in parts[1:]:
                block.append(f"       {BOLD}{p}{RST}" + " " * max(0, w - 7 - len(p)))
            extra = " · ".join(x for x in (r["wt"], r["pr"]) if x)
            detail = fit(extra or label, w - 8)
            block.append(f"       {DIM}{detail}{RST}" + " " * max(0, w - 7 - len(detail)))
            if r["selected"]:
                tint = bg(24)
            elif r["tty"] == hover:
                tint = bg(238)
            else:
                tint = ""
            for ln in block:
                add(tint + ln.replace(RST, RST + tint) + RST if tint else ln, r["tty"])
            if i < len(rs) - 1:
                add("")
        add("")
    add(f"{DIM} click: go to session · q: quit{RST}")
    return lines, hit


# ── interactive loop ────────────────────────────────────────────────────────

def focus(gpid, tty_):
    if gpid:
        return run(["osascript", "-l", "JavaScript", "-e", JXA_FOCUS, str(gpid), "/dev/" + tty_], timeout=5).strip()
    return ""


def activate(pid):
    if pid:
        run(["osascript", "-l", "JavaScript", "-e", f"Application({int(pid)}).activate()"], timeout=5)


def interactive(every):
    state = {"gpid": None, "rows": [], "dirty": True, "hover": None, "focused": True}
    me = ghostty_pid([os.getpid()])  # the Ghostty this list runs in
    lock = threading.Lock()

    def refresher():
        while True:
            try:
                gpid, rows = collect()
                with lock:
                    state.update(gpid=gpid, rows=rows, dirty=True)
            except Exception as e:  # one failed refresh must not kill the list
                sys.stderr.write(f"{time.strftime('%H:%M:%S')} {e!r}\n")
            time.sleep(every)

    threading.Thread(target=refresher, daemon=True).start()
    signal.signal(signal.SIGWINCH, lambda *_: state.update(dirty=True))

    fd = sys.stdin.fileno()
    old = termios.tcgetattr(fd)
    out = sys.stdout
    # alternate screen, no cursor, mouse with motion (1003) in SGR, focus events (1004)
    out.write(ESC + "?1049h" + ESC + "?25l" + ESC + "?1003h" + ESC + "?1006h" + ESC + "?1004h")
    out.flush()
    hit = {}
    buf = ""
    try:
        tty.setcbreak(fd)
        while True:
            with lock:
                if state["dirty"]:
                    state["dirty"] = False
                    cols, rows_n = os.get_terminal_size()
                    lines, hit = render(state["rows"], cols, state["hover"]) if state["rows"] or state["gpid"] else (
                        [" ◆ Sessions", "", DIM + " loading…" + RST], {})
                    out.write(ESC + "H" + ESC + "2J" + "\n".join(lines[:rows_n]))
                    out.flush()
            r, _, _ = select.select([fd], [], [], 0.25)
            if not r:
                continue
            buf += os.read(fd, 1024).decode("utf-8", "replace")
            while buf:
                m = re.match(r"\033\[<(\d+);(\d+);(\d+)([Mm])", buf)
                if m:
                    buf = buf[m.end():]
                    b, y, kind = int(m.group(1)), int(m.group(3)), m.group(4)
                    target = hit.get(y - 1)
                    if b & 32:  # motion
                        if not state["focused"]:
                            # Without this the first click only activates the window.
                            state["focused"] = True
                            activate(me)
                        if target != state["hover"]:
                            with lock:
                                state.update(hover=target, dirty=True)
                    elif kind == "M" and b == 0 and target:
                        focus(state["gpid"], target)
                        with lock:
                            state["dirty"] = True
                    continue
                if buf.startswith("\033[I") or buf.startswith("\033[O"):
                    with lock:
                        state["focused"] = buf[2] == "I"
                        if not state["focused"]:
                            state.update(hover=None, dirty=True)
                    buf = buf[3:]
                    continue
                if buf.startswith("\033") and len(buf) < 16 and re.fullmatch(r"\033(\[<?[\d;]*)?", buf):
                    break  # a sequence still arriving
                ch, buf = buf[0], buf[1:]
                if ch in ("q", "Q"):
                    return
                if ch in ("r", "R"):
                    with lock:
                        state["dirty"] = True
    finally:
        out.write(ESC + "?1004l" + ESC + "?1006l" + ESC + "?1003l" + ESC + "?25h" + ESC + "?1049l")
        out.flush()
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def sidebar_running():
    """Whether a sidebar (this script with --watch) is already running."""
    me = os.path.basename(os.path.abspath(__file__))
    for line in run(["ps", "-A", "-o", "pid=,args="]).splitlines():
        pid, _, args = line.strip().partition(" ")
        if pid.isdigit() and int(pid) != os.getpid() and re.search(r"(^|/)" + re.escape(me) + r"['\"]? --watch ", args + " "):
            return True
    return False


def open_sidebar():
    if sidebar_running():
        print("ghostty-sessions: the sidebar is already open")
        return
    subprocess.run(sidebar_command(), check=True)


def auto_open():
    """For a SessionStart hook: never fails, never prints, never blocks the session."""
    try:
        if CFG.get("auto_open") and os.environ.get("TERM_PROGRAM", "").lower() == "ghostty" \
                and os.path.isdir(CFG["ghostty_app"]) and not sidebar_running():
            subprocess.run(sidebar_command(), timeout=10, capture_output=True)
    except Exception:
        pass


def check():
    """Everything the sidebar needs, one line each. Exit 1 if something is missing."""
    import platform
    ok = True

    def line(good, text, fix=""):
        nonlocal ok
        ok = ok and good
        print(("ok      " if good else "MISSING ") + text + ("" if good or not fix else f" ({fix})"))

    line(platform.system() == "Darwin", "macOS", "Ghostty's AppleScript support is macOS only")
    line(sys.version_info >= (3, 9), f"Python {platform.python_version()}", "needs 3.9 or later")
    line(os.path.isdir(CFG["ghostty_app"]), f"Ghostty at {CFG['ghostty_app']}", 'set "ghostty_app" in the config')
    term = os.environ.get("TERM_PROGRAM", "")
    line(term.lower() == "ghostty", f"running inside Ghostty (TERM_PROGRAM={term or 'unset'})",
         "only sessions running in Ghostty are listed")
    line(bool(CFG["claude_dirs"]), "Claude Code folders: " + (", ".join(CFG["claude_dirs"]) or "none"))
    exists = os.path.isfile(CONFIG_PATH)
    print(f"config  {CONFIG_PATH}" + ("" if exists else " (not written yet)"))
    for src in CFG["plans"]:
        n = len(glob.glob(src["dir"] + src["pattern"]))
        line(n > 0, f"plans: {n} files match {src['dir']}{src['pattern']}", "check dir and pattern")
    print(f"auto_open: {bool(CFG.get('auto_open'))} · sidebar open: {sidebar_running()}")
    return 0 if ok else 1


def sidebar_command():
    """The `open` command for the sidebar. A separate Ghostty instance, because only a
    new instance takes a position and size; Ghostty always opens it on the main display."""
    me = os.path.abspath(__file__)
    sb = CFG["sidebar"]
    return ["open", "-na", CFG["ghostty_app"], "--args",
            "--window-position-x=0", "--window-position-y=0",
            f"--window-width={int(sb['width'])}", "--window-height=300",
            f"--font-size={sb['font_size']}",
            "--window-save-state=never", "--macos-titlebar-style=hidden",
            "--quit-after-last-window-closed=true",
            f"--command={shlex.quote(sys.executable)} {shlex.quote(me)} --watch 3"]


def main():
    global CFG
    args = sys.argv[1:]
    try:
        CFG = load_config()
    except SystemExit:
        if args[:1] == ["--auto-open"]:  # a broken config must not show up at every session start
            return
        raise
    if args[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
    elif args[:1] == ["--watch"] and len(args) > 1:
        os.makedirs(os.path.dirname(LOG), exist_ok=True)
        sys.stderr = open(LOG, "a", buffering=1)
        interactive(float(args[1]))
    elif args[:1] == ["--sidebar"]:
        open_sidebar()
    elif args[:1] == ["--auto-open"]:
        auto_open()
    elif args[:1] == ["--check"]:
        sys.exit(check())
    elif args[:1] == ["--plan"] and len(args) > 1:
        assign_plan(args[1])
    elif args:
        sys.exit(f"ghostty-sessions: unknown option {args[0]!r} (try --help)")
    else:
        gpid, rows = collect()
        if not gpid:
            sys.exit("ghostty-sessions: no Claude Code session found running inside Ghostty")
        width = os.get_terminal_size().columns if sys.stdout.isatty() else CFG["sidebar"]["width"]
        print("\n".join(render(rows, width)[0]))


if __name__ == "__main__":
    main()
